# 5. Exportar al JSON final
# Quitamos auto_unbox = TRUE para que las listas SIEMPRE sean Arrays en JSON
json_data <- toJSON(df_procesado, pretty = T)
write(json_data, "candidatos_master.json")
library(dplyr)
library(readr)
library(stringi)
library(tidyr)    # Vital para crear las listas anidadas (historiales)
library(jsonlite)
# Función auxiliar para normalizar textos (vital para los cruces)
normalizar_texto <- function(x) {
stri_trans_general(tolower(trimws(x)), "Latin-ASCII")
}
df_pres <- read_csv("directorio_candidatos_presidente.csv", col_types = cols(.default = "c")) %>%
rename(candidato = Nombre_candidato, nombre_partido = Nombre_partido) %>%
mutate(cargo_2026 = "Presidente") %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
df_sen <- read_csv("directorio_senadores.csv", col_types = cols(.default = "c")) %>%
mutate(cargo_2026 = "Senador") %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
df_dip <- read_csv("directorio_diputados.csv", col_types = cols(.default = "c")) %>%
mutate(cargo_2026 = "Diputado") %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
# ¡Ahora el bind_rows funcionará a la perfección!
directorio_unido <- bind_rows(df_pres, df_sen, df_dip) %>%
mutate(
nombre_match = normalizar_texto(candidato),
partido_match = normalizar_texto(nombre_partido),
id_unico = gsub("[^a-z0-9]", "_", paste(nombre_match, partido_match, sep="_"))
) %>%
group_by(id_unico, candidato, nombre_partido) %>%
summarise(
cargos = list(unique(cargo_2026)),
idFoto = first(nombre_archivo_imagen),
nombre_match = first(nombre_match), # Lo guardamos para cruzar luego
.groups = 'drop'
)
View(directorio_unido)
# ==============================================================================
# 3. LA PIEDRA ROSETTA: CRUCE CON EL DNI (politicos_2026.csv)
# ==============================================================================
# Necesitamos el DNI para buscar las afiliaciones y elecciones pasadas
df_politicos <- read_csv("politicos_2026.csv", col_types = cols(.default = "c")) %>%
mutate(nombre_match = normalizar_texto(NOMBRES)) %>%
select(nombre_match, DNI) %>%
distinct(nombre_match, .keep_all = TRUE) # Evitar duplicados por seguridad
# Le pegamos el DNI a nuestro directorio
base_candidatos <- directorio_unido %>%
left_join(df_politicos, by = "nombre_match")
# A. Historial Electoral
df_electoral <- read_csv("hechos_procesos_electorales.csv", col_types = cols(.default = "c")) %>%
mutate(
anio = gsub("[^0-9]", "", `PROCESO ELECTORAL`), # Extrae el año (ej. de "ELECCIONES 2021" saca "2021")
partido = `ORGANIZACIÓN POLÍTICA`,
rol = `CARGO AL QUE POSTULÓ`,
elegido = ELEGIDO
) %>%
select(DNI, anio, partido, rol, elegido) %>%
# Agrupamos todas las filas de un mismo DNI en una lista llamada 'historialElectoral'
nest(historialElectoral = c(anio, partido, rol, elegido))
# B. Historial Partidario (Afiliaciones)
df_afiliaciones <- read_csv("hechos_afiliaciones.csv", col_types = cols(.default = "c")) %>%
rename(DNI = `DNI_Político`) %>%
mutate(
fechaInicio = `Inicio de afiliación`,
partido = `Organización Política`,
rol = Tipo_Registro,
# Extraemos solo el año para mantener el formato de tu JSON
anio_inicio = substr(fechaInicio, 7, 10),
anio_fin = ifelse(is.na(`Termino de afiliación`), "Act.", substr(`Termino de afiliación`, 7, 10)),
anio = paste(anio_inicio, "-", anio_fin)
) %>%
select(DNI, anio, fechaInicio, partido, rol) %>%
nest(historialPartidario = c(anio, fechaInicio, partido, rol))
# ==============================================================================
# 5. EL GRAN CRUCE (LEFT JOINS)
# ==============================================================================
# Unimos la base principal con sus respectivos historiales usando el DNI
super_base <- base_candidatos %>%
left_join(df_electoral, by = "DNI") %>%
left_join(df_afiliaciones, by = "DNI") %>%
# Si un candidato es nuevo y no tiene historial, R pondrá NULL.
# Lo cambiamos a listas vacías para que Javascript no dé errores de undefined.
mutate(
historialElectoral = lapply(historialElectoral, function(x) if(is.null(x)) list() else x),
historialPartidario = lapply(historialPartidario, function(x) if(is.null(x)) list() else x)
) %>%
# Limpieza final: renombramos y ordenamos para Javascript
rename(
nombre = candidato,
partidoActual = nombre_partido,
dni = DNI
) %>%
select(id_unico, dni, nombre, partidoActual, cargos, idFoto, historialElectoral, historialPartidario)
# ==============================================================================
# 6. EXPORTACIÓN A JSON MAGISTRAL
# ==============================================================================
# Obligamos a que 'cargos' sea tratada como Array en JSON (la función I)
super_base$cargos <- I(super_base$cargos)
# Generamos el JSON
json_final <- toJSON(super_base, pretty = TRUE, auto_unbox = TRUE, null = "null")
write(json_final, "candidatos_super_master.json")
print("¡Éxito total! Archivo candidatos_super_master.json generado.")
library(dplyr)
library(readr)
library(stringi)
library(jsonlite)
# Función auxiliar para normalizar nombres y crear IDs únicos
normalizar_id <- function(x) {
gsub("[^a-z0-9]", "_", stri_trans_general(tolower(trimws(x)), "Latin-ASCII"))
}
# 1. Cargar el directorio de logos
df_logos <- read_csv("directorio_partidos.csv", col_types = cols(.default = "c")) %>%
mutate(
id_partido = normalizar_id(Nombre_partido),
nombre_partido = trimws(Nombre_partido)
) %>%
rename(logo = nombre_archivo_imagen_partido)
# 2. Cargar la dimensión oficial del JNE (opcional, pero da contexto periodístico)
df_jne <- read_csv("dim_organizaciones_politicas.csv", col_types = cols(.default = "c")) %>%
mutate(
id_partido = normalizar_id(`Organización Política`),
tipo = `Tipo partido`,
alcance = Alcance,
estado = `Estado Org. Política`
) %>%
select(id_partido, tipo, alcance, estado)
# 3. Cruzar la información
df_partidos <- df_logos %>%
left_join(df_jne, by = "id_partido") %>%
# Agregamos un campo de color vacío para que lo llenes mañana
mutate(colorHEX = "#CCCCCC") %>%
select(id_partido, nombre_partido, logo, tipo, alcance, estado, colorHEX)
# 4. Transformar en una lista nombrada (Diccionario Indexado para JS)
# Esto permite que en JS busques un partido directo por su ID en vez de usar un .find()
lista_partidos <- split(df_partidos, df_partidos$id_partido)
# Limpiar un poco la estructura de la lista para que quede perfecta en JSON
lista_partidos <- lapply(lista_partidos, function(x) {
list(
nombre = x$nombre_partido,
logo = x$logo,
tipo = x$tipo,
alcance = x$alcance,
estado = x$estado,
color = x$colorHEX
)
})
# 5. Exportar a JSON
json_partidos <- toJSON(lista_partidos, pretty = TRUE, auto_unbox = TRUE, null = "null")
write(json_partidos, "diccionario_partidos.json")
# ==============================================================================
# SCRIPT MAESTRO R - ECDATA (CAMALEONES POLÍTICOS)
# ==============================================================================
# Este script procesa los CSV brutos y genera los dos JSON optimizados para la web.
library(dplyr)
library(readr)
library(stringi)
library(tidyr)
library(jsonlite)
# Función auxiliar para normalizar textos (vital para los cruces exactos)
normalizar_texto <- function(x) {
stri_trans_general(tolower(trimws(x)), "Latin-ASCII")
}
# ==============================================================================
# PARTE 1: GENERACIÓN DEL SUPER MASTER DE CANDIDATOS
# ==============================================================================
# 1. Cargar directorios y estandarizar columnas
# CORRECCIÓN APLICADA: Respetamos la columna 'Cargo' original para incluir Vicepresidentes
df_pres <- read_csv("directorio_candidatos_presidente.csv", col_types = cols(.default = "c")) %>%
rename(
candidato = Nombre_candidato,
nombre_partido = Nombre_partido,
cargo_2026 = Cargo
) %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
df_sen <- read_csv("directorio_senadores.csv", col_types = cols(.default = "c")) %>%
mutate(cargo_2026 = "Senador") %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
df_dip <- read_csv("directorio_diputados.csv", col_types = cols(.default = "c")) %>%
mutate(cargo_2026 = "Diputado") %>%
select(candidato, nombre_partido, cargo_2026, nombre_archivo_imagen)
# 2. Unir directorios y agrupar por candidato (detectar postulaciones múltiples)
directorio_unido <- bind_rows(df_pres, df_sen, df_dip) %>%
mutate(
nombre_match = normalizar_texto(candidato),
partido_match = normalizar_texto(nombre_partido),
id_unico = gsub("[^a-z0-9]", "_", paste(nombre_match, partido_match, sep="_"))
) %>%
group_by(id_unico, candidato, nombre_partido) %>%
summarise(
# Colapsamos los cargos en un array sin duplicados
cargos = list(unique(trimws(cargo_2026))),
idFoto = first(nombre_archivo_imagen),
nombre_match = first(nombre_match),
.groups = 'drop'
)
# 3. Cruzar con DNI (La Piedra Rosetta)
df_politicos <- read_csv("politicos_2026.csv", col_types = cols(.default = "c")) %>%
mutate(nombre_match = normalizar_texto(NOMBRES)) %>%
select(nombre_match, DNI) %>%
distinct(nombre_match, .keep_all = TRUE)
base_candidatos <- directorio_unido %>%
left_join(df_politicos, by = "nombre_match")
# 4. Construir Historiales (Nesting)
# A. Historial Electoral
df_electoral <- read_csv("hechos_procesos_electorales.csv", col_types = cols(.default = "c")) %>%
mutate(
anio = gsub("[^0-9]", "", `PROCESO ELECTORAL`),
partido = `ORGANIZACIÓN POLÍTICA`,
rol = `CARGO AL QUE POSTULÓ`,
elegido = ELEGIDO
) %>%
select(DNI, anio, partido, rol, elegido) %>%
nest(historialElectoral = c(anio, partido, rol, elegido))
# B. Historial Partidario
df_afiliaciones <- read_csv("hechos_afiliaciones.csv", col_types = cols(.default = "c")) %>%
rename(DNI = `DNI_Político`) %>%
mutate(
fechaInicio = `Inicio de afiliación`,
partido = `Organización Política`,
rol = Tipo_Registro,
anio_inicio = substr(fechaInicio, 7, 10),
anio_fin = ifelse(is.na(`Termino de afiliación`), "Act.", substr(`Termino de afiliación`, 7, 10)),
anio = paste(anio_inicio, "-", anio_fin)
) %>%
select(DNI, anio, fechaInicio, partido, rol) %>%
nest(historialPartidario = c(anio, fechaInicio, partido, rol))
# 5. Cruce final de la base super master
super_base <- base_candidatos %>%
left_join(df_electoral, by = "DNI") %>%
left_join(df_afiliaciones, by = "DNI") %>%
mutate(
# Reemplazar NULLs por listas vacías para evitar errores en JS
historialElectoral = lapply(historialElectoral, function(x) if(is.null(x)) list() else x),
historialPartidario = lapply(historialPartidario, function(x) if(is.null(x)) list() else x)
) %>%
rename(
nombre = candidato,
partidoActual = nombre_partido,
dni = DNI
) %>%
select(id_unico, dni, nombre, partidoActual, cargos, idFoto, historialElectoral, historialPartidario)
# 6. Exportar JSON de Candidatos
super_base$cargos <- I(super_base$cargos) # Forzar Array en el JSON
json_candidatos <- toJSON(super_base, pretty = TRUE, auto_unbox = TRUE, null = "null")
write(json_candidatos, "candidatos_super_master.json")
print("✅ Parte 1 Completa: candidatos_super_master.json generado correctamente.")
# ==============================================================================
# PARTE 2: GENERACIÓN DEL DICCIONARIO DE PARTIDOS
# ==============================================================================
normalizar_id_partido <- function(x) {
gsub("[^a-z0-9]", "_", stri_trans_general(tolower(trimws(x)), "Latin-ASCII"))
}
# Cargar logos
df_logos <- read_csv("directorio_partidos.csv", col_types = cols(.default = "c")) %>%
mutate(
id_partido = normalizar_id_partido(Nombre_partido),
nombre_partido = trimws(Nombre_partido)
) %>%
rename(logo = nombre_archivo_imagen_partido)
# Cargar metadata del JNE
df_jne <- read_csv("dim_organizaciones_politicas.csv", col_types = cols(.default = "c")) %>%
mutate(
id_partido = normalizar_id_partido(`Organización Política`),
tipo = `Tipo partido`,
alcance = Alcance,
estado = `Estado Org. Política`
) %>%
select(id_partido, tipo, alcance, estado)
# Cruzar data y añadir color por defecto
df_partidos <- df_logos %>%
left_join(df_jne, by = "id_partido") %>%
mutate(colorHEX = "#CCCCCC") %>%
select(id_partido, nombre_partido, logo, tipo, alcance, estado, colorHEX)
# Convertir a Objeto Indexado
lista_partidos <- split(df_partidos, df_partidos$id_partido)
lista_partidos <- lapply(lista_partidos, function(x) {
list(
nombre = x$nombre_partido,
logo = x$logo,
tipo = x$tipo,
alcance = x$alcance,
estado = x$estado,
color = x$colorHEX
)
})
# Exportar JSON de Partidos
json_partidos <- toJSON(lista_partidos, pretty = TRUE, auto_unbox = TRUE, null = "null")
write(json_partidos, "diccionario_partidos.json")
print("✅ Parte 2 Completa: diccionario_partidos.json generado correctamente.")
