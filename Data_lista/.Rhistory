# 1. Cargar librerías necesarias
library(dplyr)
library(readr)   # Más rápido y robusto que read.csv nativo
library(stringi) # Para quitar tildes
library(jsonlite)# Para exportar el JSON
# 2. Importar los archivos y asignarles su cargo correspondiente
# Nota: Ajusta 'candidato' y 'nombre_partido' si tus columnas se llaman distinto
df_presidente <- read_csv("directorio_candidatos_presidente.csv", show_col_types = FALSE) %>%
mutate(cargo_asignado = "Presidente")
df_presidente<- df_presidente %>% rename(candidato="Nombre_candidato")
df_presidente<- df_presidente %>% rename(nombre_partido="Nombre_partido")
df_presidente<- df_presidente %>% rename(cargo="Cargo")
df_presidente$distrito_electoral<-"NACIONAL"
df_senadores <- read_csv("directorio_senadores.csv", show_col_types = FALSE) %>%
mutate(cargo_asignado = "Senador")
df_senadores<- df_senadores %>% select(-tipo_senador)
df_diputados <- read_csv("directorio_diputados.csv", show_col_types = FALSE) %>%
mutate(cargo_asignado = "Diputado")
# 3. Consolidar todo en un solo dataframe maestro
df_consolidado <- bind_rows(df_presidente, df_senadores, df_diputados)
# 4. Procesamiento, limpieza y agrupación
df_procesado <- df_consolidado %>%
# Limpieza y creación del ID único compuesto
mutate(
nombre_limpio = stri_trans_general(tolower(trimws(candidato)), "Latin-ASCII"),
partido_limpio = stri_trans_general(tolower(trimws(nombre_partido)), "Latin-ASCII"),
id_unico = gsub("[^a-z0-9]", "_", paste(nombre_limpio, partido_limpio, sep="_"))
) %>%
# Agrupamos por el ID único para detectar dobles postulaciones
group_by(id_unico, candidato, nombre_partido) %>%
# Colapsamos los cargos en una lista (Array en JS)
summarise(
cargos = list(unique(trimws(cargo_asignado))),
.groups = 'drop'
) %>%
# Renombramos para que el JS lo lea fácil
rename(
nombre = candidato,
partido = nombre_partido
) %>%
# Generamos el ID de la foto basado solo en el nombre
mutate(idFoto = gsub("[^a-z0-9]", "_", stri_trans_general(tolower(nombre), "Latin-ASCII")))
View(df_procesado)
# 5. Exportar al JSON final
json_data <- toJSON(df_procesado, pretty = FALSE, auto_unbox = TRUE)
write(json_data, "candidatos_master.json")
print("¡Proceso terminado! candidatos_master.json generado con éxito.")
# 5. Exportar al JSON final
json_data <- toJSON(df_procesado, pretty = FALSE, auto_unbox = TRUE)
write(json_data, "candidatos_master.json")
print("¡Proceso terminado! candidatos_master.json generado con éxito.")
